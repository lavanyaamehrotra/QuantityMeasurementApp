# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=YourSuperSecretKeyAtLeast32CharsLong!
JWT_ISSUER=QuantityMeasurementAPI
JWT_AUDIENCE=QuantityMeasurementAPI
JWT_EXPIRATION_MINUTES=60

# ─── Auth Service DB ──────────────────────────────────────────────────────────
AUTH_DB_CONNECTION=Server=localhost;Port=5432;Database=auth_db;Username=postgres;Password=postgres

# ─── QMA Service DB ───────────────────────────────────────────────────────────
QMA_DB_CONNECTION=Server=localhost;Port=5432;Database=qma_db;Username=postgres;Password=postgres

# ─── Service URLs ─────────────────────────────────────────────────────────────
AUTH_SERVICE_URL=http://auth-service:8081
QMA_SERVICE_URL=http://qma-service:8082

# ─── Encryption ───────────────────────────────────────────────────────────────
ENCRYPTION_KEY=DevFallbackKey_ChangeInProduction_32Chars!

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
