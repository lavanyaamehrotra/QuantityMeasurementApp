{
  "JwtSettings": {
    "Secret": "YourSuperSecretKeyAtLeast32CharsLong!",
    "Issuer": "QuantityMeasurementAPI",
    "Audience": "QuantityMeasurementAPI"
  },
  "Services": {
    "AuthService": "http://auth-service:8081",
    "QmaService": "http://qma-service:8082"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "qma-route": {
        "ClusterId": "qma-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/qma/{**catch-all}"
        }
      },
      "qma-health-route": {
        "ClusterId": "qma-cluster",
        "Match": {
          "Path": "/api/qma/health"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://auth-service:8081"
          }
        }
      },
      "qma-cluster": {
        "Destinations": {
          "qma-service": {
            "Address": "http://qma-service:8082"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*"
}
